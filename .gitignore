# ============================================================
# SHIELDON - Root .gitignore
# Covers: Angular, .NET, Visual Studio, VS Code, Windows
# ============================================================
    
# ── SECRETS - NEVER COMMIT ──────────────────────────────────
appsettings.Development.json
appsettings.Production.json
appsettings.Staging.json
secrets.json
.env
.env.local
.env.development
.env.production
scratch/
CLAUDE.md
stripe_cli/
*.zip
frontend/src/environments/environment.ts
auth_info/
auth_info_baileys/
auth-info/
start-dev.ps1

# ── .NET / Visual Studio ────────────────────────────────────
*.user
*.suo
*.userosscache
*.sln.docstates
.vs/
.idea/
[Dd]ebug/
[Rr]elease/
[Bb]in/
[Oo]bj/
*.exe
*.dll
*.pdb
*.cache
*.log
*_logs.txt
backend_logs.txt
TestResults/
*.trx
*.nupkg
*.snupkg
project.lock.json
project.fragment.lock.json
artifacts/

# ── Databases & Security Certificates ────────────────────────
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3
*.pem
*.key
*.pfx
*.p12

# ── Angular / Node / Test Coverage ──────────────────────────
node_modules/
dist/
coverage/
.nyc_output/
.angular/
.cache/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
*.tsbuildinfo

# ── VS Code ─────────────────────────────────────────────────
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# ── macOS ────────────────────────────────────────────────────
.DS_Store
.AppleDouble
.LSOverride
Thumbs.db

# ── Uploads (local dev only - never commit uploaded files) ──
backend/SHIELDON.API/wwwroot/uploads/
backend/SHIELDON.API/wwwroot/Storage/
backend/SHIELDON.API/Storage/
